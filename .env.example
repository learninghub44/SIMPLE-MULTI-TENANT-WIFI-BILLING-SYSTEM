# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (PostgreSQL)
# For Render: This will be automatically set by Render's PostgreSQL service
# For Docker Compose, use host `db` instead of `localhost`.
DATABASE_URL=postgresql://user:password@localhost:5432/wifi_billing
POSTGRES_DB=wifi_billing
POSTGRES_USER=wifi_user
POSTGRES_PASSWORD=replace-with-a-strong-password
PGADMIN_DEFAULT_PASSWORD=replace-with-a-strong-password

# JWT Secret - Generate a strong random secret
JWT_SECRET=your-secure-random-jwt-secret-here-change-in-production

# Multi-operator routing. Set this after buying the platform domain.
# Route the apex and wildcard operator subdomains to the static frontend,
# and api.yourdomain.com to the Node API host.
OPERATOR_BASE_DOMAIN=yourdomain.com
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
PUBLIC_API_BASE_URL=https://api.yourdomain.com

# Optional dedicated key for encrypting operator PayHero and MikroTik credentials.
# If omitted, the app derives a separate key from SESSION_SECRET or JWT_SECRET.
# Keep the chosen master secret stable or existing encrypted credentials cannot be read.
PAYMENT_CREDENTIALS_KEY=

# Admin Credentials
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_EMAIL=admin@yourdomain.com

# M-Pesa Configuration
MPESA_ENABLED=true
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_SHORTCODE=your_mpesa_shortcode
MPESA_PASSKEY=your_mpesa_passkey
MPESA_CALLBACK_URL=https://your-render-app.onrender.com/api/mpesa/callback

# MikroTik Configuration
MIKROTIK_ENABLED=true
MIKROTIK_HOST=192.168.88.1
MIKROTIK_USER=your_mikrotik_username
MIKROTIK_PASSWORD=your_mikrotik_password
MIKROTIK_PORT=8728

# Loan Configuration
LOAN_WIFI_DURATION_HOURS=1

# Additional Admin (for MikroTik)
MIKROTIK_ADMIN_USERNAME=admin
MIKROTIK_ADMIN_PASSWORD=admin123